# User unit example; replace absolute paths. Does not set up AP/pairing.
[Unit]
Description=DiPlay Linux Web receiver preview
After=default.target
[Service]
Type=simple
ExecStart=/ABSOLUTE/PATH/TO/DiPlay/desktop/diplay --mode web --config /ABSOLUTE/PATH/TO/config.toml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
[Install]
WantedBy=default.target
